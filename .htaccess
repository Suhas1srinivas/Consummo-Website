# =====================================================================
# Consummo website: security, HTTPS and performance rules
# Works on Hostinger (LiteSpeed / Apache). Keep this file at the site root.
# =====================================================================

Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# ---------- Redirects ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # consummo.com -> www.consummo.com (matches the canonical URLs)
  RewriteCond %{HTTP_HOST} ^consummo\.com$ [NC]
  RewriteRule ^ https://www.consummo.com%{REQUEST_URI} [L,R=301]

  # Hide everything that is not part of the public website
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^(README\.md|package(-lock)?\.json|server\.js|tools/.*)$ - [F,L]
  RewriteRule ^api/(data/.*|config(\.sample)?\.php)$ - [F,L]
  RewriteRule \.(bak|old_bak|old|orig|log|sql|sqlite|csv|env|ini|sh|ps1|py|md|lock|yml|yaml)$ - [F,L]

  # Only contact.php may run in /api/
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteCond %{REQUEST_URI} !^/api/contact\.php$
  RewriteRule ^ - [F,L]
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "(^README\.md|^package\.json|^server\.js|\.(bak|log|sql|csv|env|md|py|sh|ps1)$)">
  Require all denied
</FilesMatch>

# ---------- Security headers ----------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self'; frame-src 'none'; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests"
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>

# ---------- Caching (fingerprinted assets cache for a year, pages revalidate) ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>
